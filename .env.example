# Copy to .env (never commit .env) and fill in. Read by the root docker-compose.yml.
# Avoid "$" in values: Compose treats it as a variable reference.

# PostgreSQL schema owner (also the superuser of this container's database)
POSTGRES_DB=erpcafe
POSTGRES_USER=erpcafe
POSTGRES_PASSWORD=change-me-owner-password

# erp_app, the role the backend's requests run as (row-level security applies to it).
# Must not contain "$$" or "$pw$", nor end in "$" or "$pw" (backend/ARCHITECTURE.md §10).
APP_DB_PASSWORD=change-me-app-password

# JWT signing secret, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=

# First owner account, created on an empty database (ADMIN_PASSWORD is needed only then)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Where the app is reached (the tunnel's https:// address once it has a fixed one), and the port
# nginx listens on, on this machine only
WEB_PORT=8095
APP_PUBLIC_URL=http://localhost:8095

# The refresh cookie's Secure flag: false for plain http://localhost, true behind HTTPS. Set it to
# true with a Cloudflare tunnel, or everyone is signed out every 15 minutes.
REFRESH_COOKIE_SECURE=false

# The optional containers to run, comma-separated (docs/deploy.md):
#   quick-tunnel  on the internet at a random trycloudflare.com address, no account or domain needed
#   tunnel        on the internet at your own domain, needs TUNNEL_TOKEN
#   backup        a database dump into ./backups once a day
#   autoupdate    swap in the images CI publishes from main, checked every 5 minutes
# For example COMPOSE_PROFILES=tunnel,backup,autoupdate. Empty: only this machine can reach the app.
COMPOSE_PROFILES=

# The named tunnel's token, from the Cloudflare dashboard (the "tunnel" profile only)
TUNNEL_TOKEN=

# How many days of daily backups to keep (the "backup" profile only)
BACKUP_KEEP_DAYS=14

# Signing in to ghcr.io, where the images are private (the "autoupdate" profile only): your GitHub
# user name and a classic personal access token with only the read:packages scope
GHCR_USER=
GHCR_TOKEN=
